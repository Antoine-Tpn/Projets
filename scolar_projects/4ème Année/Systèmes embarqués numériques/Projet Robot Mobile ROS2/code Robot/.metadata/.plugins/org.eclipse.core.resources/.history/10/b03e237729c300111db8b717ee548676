static void task_Sensor(void *pvParameters)
{
    struct AMessage pxMessage;
    for (;;)
    {
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4, 0);
        captDistIR_Get(tab_distIR);
        distL = captDistIR_ToCm(tab_distIR[0]);
        distR = captDistIR_ToCm(tab_distIR[1]);

        if (distL > 80)
            distL = 80;
        if (distR > 80)
            distR = 80;

        distB = (int)(VL53L0X_readRangeSingleMillimeters()/10);
        if (currentMode == MODE_RANDOM)
        {
            if (compteur >= 600)
            {
                compteur = 0;
                int random = rand() % 5;
                switch (random)
                {
                    case 0: pxMessage.command = 'R'; break;
                    case 1: pxMessage.command = 'L'; break;
                    case 2: pxMessage.command = 'B'; break;
                    case 3: pxMessage.command = 'F'; break;
                    case 4: pxMessage.command = 'S'; break;
                }
                pxMessage.data = 40;
            }
            compteur++;

            if (distL <= 40 || distR <= 40 || distB <= 40)
            {
                if (distL <= 40 && distR <= 40)
                {
                    pxMessage.command = 'B';
                    pxMessage.data = distL;
                }
                else
                {
                    if (distL <= 40)
                    {
                        pxMessage.command = 'R';
                        pxMessage.data = distL;
                    }
                    if (distR <= 40)
                    {
                        pxMessage.command = 'L';
                        pxMessage.data = distR;
                    }
                }
                if (distB <= 40)
                {
                    pxMessage.command = 'F';
                    pxMessage.data = distB;
                }
                xQueueSend(qh, &pxMessage, 0);
                xSemaphoreGive(xSemaphore);
            }
        }
        vTaskDelay(pdMS_TO_TICKS(SAMPLING_PERIOD_ms));
    }
}


static void task_Manual(void *pvParameters)
{
    struct AMessage pxRxedMessage;

    for (;;)
    {
        if (currentMode == MODE_MANUEL)
        {
            groveLCD_setCursor(0, 0);
            groveLCD_term_printf("Mode");

            groveLCD_setCursor(0, 1);
            groveLCD_term_printf("Manual");

            if (xQueueReceive(qh, &pxRxedMessage, 0) == pdPASS)
            {
                last_command = pxRxedMessage.command;
            }

            switch (last_command)
            {
                case 'F':
                    moveForward(motorSpeed);
                    break;

                case 'B':
                    moveBackward(motorSpeed);
                    break;

                case 'L':
                    turnLeft(motorSpeed);
                    break;

                case 'R':
                    turnRight(motorSpeed);
                    break;

                case 'S':
                    stop();
                    break;

                default:
                    break;
            }
        }
       vTaskDelay(pdMS_TO_TICKS(10));
    }
}

static void task_Random(void *pvParameters)
{
    struct AMessage pxRxedMessage;

    for (;;)
    {
        if (currentMode == MODE_RANDOM)
        {
            groveLCD_setCursor(0, 0);
            groveLCD_term_printf("Mode");

            groveLCD_setCursor(0, 1);
            groveLCD_term_printf("Random");

            if (xSemaphoreTake(xSemaphore, 0) == pdPASS)
            {
                if (xQueueReceive(qh, &pxRxedMessage, 0) == pdPASS)
                {
                    last_command = pxRxedMessage.command;
                }
                    switch (last_command)
                    {
                        case 'F':
                            stop();
                            moveForward(motorSpeed);
                            break;

                        case 'B':
                            stop();
                            moveBackward(motorSpeed);
                            break;

                        case 'L':
                            stop();
                            turnLeft(motorSpeed);
                            break;

                        case 'R':
                            stop();
                            turnRight(motorSpeed);
                            break;

                        case 'S':
                            stop();
                            break;

                        default:
                            break;
                    }
            }
        }
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

static void task_Tracking(void *pvParameters)
{
    int error;

    for (;;)
    {
    	if (currentMode == MODE_TRACKING)
    	{
    		groveLCD_setCursor(0, 0);
			groveLCD_term_printf("Mode");
			groveLCD_setCursor(0, 1);
			groveLCD_term_printf("TRACKING");
			error = tracking_x - IMAGE_CENTER_X;
			if (error > TRACKING_DEADZONE)
			{
				// Couleur à droite
				// tourner à droite
				turnRight(motorSpeed);
			}
			else if (error < -TRACKING_DEADZONE)
			{
				// Couleur à gauche
				// tourner à gauche
				turnLeft(motorSpeed);
			}
			else
			{
				// Couleur au centre
				// avancer
				moveForward(motorSpeed);
			}
    	}
	    vTaskDelay(pdMS_TO_TICKS(10));
    }
}
