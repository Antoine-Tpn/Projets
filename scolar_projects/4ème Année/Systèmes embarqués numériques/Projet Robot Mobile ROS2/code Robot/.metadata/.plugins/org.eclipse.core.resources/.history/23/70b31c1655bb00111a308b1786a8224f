static void randomTimerCallback(TimerHandle_t xTimer)
{
    struct AMessage randomMessage;
    // Génère une commande aléatoire
    int random = rand() % 5;
    switch (random)
    {
        case 0:
            randomMessage.command = 'R';
            break;
        case 1:
            randomMessage.command = 'L';
            break;
        case 2:
            randomMessage.command = 'B';
            break;
        case 3:
            randomMessage.command = 'F';
            break;
        case 4:
            randomMessage.command = 'S';
            break;
    }
    randomMessage.data = 500;
    // Envoie la commande dans la queue
    xQueueSend(qh, &randomMessage, 0);
}

void subscription_callback(const void *msgin)
{
    const std_msgs__msg__String *msg =
        (const std_msgs__msg__String *)msgin;

    struct AMessage message;

    printf("Received from HOST: %s\r\n",
           msg->data.data);

    // Commande simple : F, B, L, R ou S
    message.command = msg->data.data[0];

    // Pas de donnée supplémentaire pour l'instant
    message.data = 500;

    // Envoie la commande à task_Manual
    if (xQueueSend(qh, &message, 0) != pdPASS)
    {
        printf("Erreur : queue pleine\r\n");
    }
}

void microros_task(void *argument)
{
    //====================================================
    // TRANSPORT MICRO-ROS
    //====================================================
    rmw_uros_set_custom_transport(
        true,
        (void *)&huart1,
        cubemx_transport_open,
        cubemx_transport_close,
        cubemx_transport_write,
        cubemx_transport_read
    );
    //====================================================
    // ALLOCATEUR
    //====================================================
    rcl_allocator_t freeRTOS_allocator =
        rcutils_get_zero_initialized_allocator();
    freeRTOS_allocator.allocate = microros_allocate;
    freeRTOS_allocator.deallocate = microros_deallocate;
    freeRTOS_allocator.reallocate = microros_reallocate;
    freeRTOS_allocator.zero_allocate = microros_zero_allocate;
    rcutils_set_default_allocator(&freeRTOS_allocator);
    //====================================================
    // SUPPORT MICRO-ROS
    //====================================================
    rclc_support_t support;
    rcl_allocator_t allocator = rcl_get_default_allocator();
    rcl_init_options_t init_options =
        rcl_get_zero_initialized_init_options();
    rcl_init_options_init(
        &init_options,
        allocator
    );
    rcl_init_options_set_domain_id(
        &init_options,
        ROS_DOMAIN_ID
    );
    rclc_support_init_with_options(
        &support,
        0,
        NULL,
        &init_options,
        &allocator
    );
    //====================================================
    // NODE
    //====================================================
    rcl_node_t node;
    rclc_node_init_default(
        &node,
        "STM32_Node",
        "",
        &support
    );
    //====================================================
    // ================= COMMAND =========================
    // ROS -> STM32
    //====================================================
    rcl_subscription_t command_subscriber;
    std_msgs__msg__String command_msg;
    rclc_subscription_init_default(
        &command_subscriber,&node,
        ROSIDL_GET_MSG_TYPE_SUPPORT(std_msgs,msg,String),"/command/move"
    );
    //====================================================
    // ================= SENSOR ==========================
    // STM32 -> ROS
    //====================================================
    rcl_publisher_t sensor_vl53_publisher;
    rcl_publisher_t sensor_ir_left_publisher;
    rcl_publisher_t sensor_ir_right_publisher;
    std_msgs__msg__String sensor_vl53_msg;
    std_msgs__msg__String sensor_ir_left_msg;
    std_msgs__msg__String sensor_ir_right_msg;
    // VL53
    rclc_publisher_init_default(
        &sensor_vl53_publisher,
        &node,
        ROSIDL_GET_MSG_TYPE_SUPPORT(std_msgs,msg,String),
        "/sensor/dist_back"
    );
    // IR gauche
    rclc_publisher_init_default(
        &sensor_ir_left_publisher,
        &node,
        ROSIDL_GET_MSG_TYPE_SUPPORT(std_msgs,msg,String),
        "/sensor/dist_left"
    );
    // IR droite
    rclc_publisher_init_default(
        &sensor_ir_right_publisher,
        &node,
        ROSIDL_GET_MSG_TYPE_SUPPORT(std_msgs, msg,String),
        "/sensor/dist_right"
    );
    //====================================================
    // ALLOCATION DES MESSAGES
    //====================================================
    command_msg.data.data =
        (char *)malloc(ARRAY_LEN);
    command_msg.data.size = 0;
    command_msg.data.capacity = ARRAY_LEN;
    sensor_vl53_msg.data.data =
        (char *)malloc(ARRAY_LEN);
    sensor_vl53_msg.data.size = 0;
    sensor_vl53_msg.data.capacity = ARRAY_LEN;
    sensor_ir_left_msg.data.data =
        (char *)malloc(ARRAY_LEN);
    sensor_ir_left_msg.data.size = 0;
    sensor_ir_left_msg.data.capacity = ARRAY_LEN;
    sensor_ir_right_msg.data.data =
        (char *)malloc(ARRAY_LEN);
    sensor_ir_right_msg.data.size = 0;
    sensor_ir_right_msg.data.capacity = ARRAY_LEN;
    //====================================================
    // EXECUTOR
    //====================================================
    rclc_executor_t executor;
    rclc_executor_init(
        &executor,
        &support.context,
        1,
        &allocator
    );
    rclc_executor_add_subscription(
        &executor,
        &command_subscriber,
        &command_msg,
        &subscription_callback,
        ON_NEW_DATA
    );
    //====================================================
    // VARIABLES CAPTEURS
    //====================================================
    int tab_distIR[2];
    int distL;
    int distR;
    int distB;
    printf("micro-ROS OK\r\n");
    //====================================================
    // BOUCLE
    //====================================================
    for (;;)
    {
        //===============================================
        // LECTURE CAPTEURS
        //===============================================
        distB =(int)(VL53L0X_readRangeSingleMillimeters() / 10);
        captDistIR_Get(tab_distIR);
        distL = captDistIR_ToCm(tab_distIR[0]);
        distR = captDistIR_ToCm(tab_distIR[1]);
        //===============================================
        // TOPIC /sensor/dist_back
        //===============================================
        sprintf(
            sensor_vl53_msg.data.data,
            "%d",
            distB
        );
        sensor_vl53_msg.data.size =
            strlen(sensor_vl53_msg.data.data);
        rcl_publish(
            &sensor_vl53_publisher,
            &sensor_vl53_msg,
            NULL
        );
        //===============================================
        // TOPIC /sensor/dist_left
        //===============================================
        sprintf(
            sensor_ir_left_msg.data.data,
            "%d",
            distL
        );
        sensor_ir_left_msg.data.size =
            strlen(sensor_ir_left_msg.data.data);

        rcl_publish(
            &sensor_ir_left_publisher,
            &sensor_ir_left_msg,
            NULL
        );
        //===============================================
        // TOPIC /sensor/dist_right
        //===============================================
        sprintf(
            sensor_ir_right_msg.data.data,
            "%d",
            distR
        );
        sensor_ir_right_msg.data.size =
            strlen(sensor_ir_right_msg.data.data);
        rcl_publish(
            &sensor_ir_right_publisher,
            &sensor_ir_right_msg,
            NULL
        );
        //===============================================
        // RECEPTION DES COMMANDES
        //===============================================
        rclc_executor_spin_some(
            &executor,
            RCL_MS_TO_NS(1)
        );
        //===============================================
        // PERIODE DE LECTURE
        //===============================================
        osDelay(50);
    }
}








