static void task_Sensor(void *pvParameters)
{
    struct AMessage pxMessage;


    for (;;)
        {
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4, 0);
        // Capteur IR Fonctionnel de range [10;80] cm
        captDistIR_Get(tab_distIR);
        distL = captDistIR_ToCm(tab_distIR[0]);
        distR = captDistIR_ToCm(tab_distIR[1]);
        // Lecture de la distance en cm (3cm a 2m)
        distB = (int)(VL53L0X_readRangeSingleMillimeters()/10);
        // Analyse et envoie des messages
        if(distL <= 40 || distR <= 40 || distB <= 40){
			if (distL <= 40 && distR <= 40) {
				pxMessage.command = 'F';
				pxMessage.data = distL;
			}
			else {
				if (distL <= 40){
					pxMessage.command='L';
					pxMessage.data=distL;
				}
				if (distR <= 40){
					pxMessage.command='R';
					pxMessage.data=distR;
				}
			}
			if(distB <= 40){
				pxMessage.command='B';
				pxMessage.data=distB;
			}
			xQueueSend( qh, ( void * ) &pxMessage,  portMAX_DELAY );
        }
        /*else {
        	pxMessage.command='N';
        	pxMessage.data=0;
        }*/
        //HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4, 1);
        printf("TASK Sensor \r\n");
        //vTaskDelay(1);
        xSemaphoreTake( xSemaphore, portMAX_DELAY );
        }
}

